% ============== 通用引用样式与数学算子（由 study.tex 迁入，共享安全） ==============
% 深红强调色（与 CWW marker 一致）
\definecolor{myemphasis}{RGB}{143, 0, 0}

% CWW talkquote：左缩进 2em、右 0、正体（对话/引用主力）
\newenvironment{talkquote}{%
  \begin{quoting}[leftmargin=2em, rightmargin=0pt, vskip=1.5ex]%
  \leavevmode\setlength{\parskip}{1.2ex}%
}{%
  \end{quoting}%
}

% CWW numbereditem：斜体、左缩进 1.5em
\newenvironment{numitem}{%
  \vspace{1.5ex}\par\noindent\itshape
  \begin{quoting}[leftmargin=1.5em, rightmargin=0pt, vskip=0pt]%
}{%
  \end{quoting}\vspace{1.5ex}%
}

% 左侧粗线框（基于 framed）
\newenvironment{leftrulebox}{%
  \def\FrameCommand{\vrule width 1pt \hspace{1em}}%
  \MakeFramed{\advance\hsize-\width\FrameRestore}\vspace{0.6em}\itshape\noindent%
}{%
  \vspace{0.6em}\endMakeFramed%
}

% 右对齐题词 epigraph 风格
\newenvironment{myepigraph}{%
  \par\vspace{1.5ex}\hfill\begin{minipage}{0.72\textwidth}\raggedleft\itshape%
}{%
  \end{minipage}\par\vspace{1.5ex}%
}

