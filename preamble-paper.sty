% 字体目录：默认 ../font/（CQT 树内）；引用方可在 \usepackage 前用 \fontdir 覆盖
\providecommand{\fontdir}{../font/}
% 使用项目本地 NotoSerifSC / NotoSansSC 静态字体
\setmainfont{NotoSerifSC}[
    Path           = \fontdir,
    Extension      = .ttf,
    UprightFont    = *-Regular,
    BoldFont       = *-Bold,
    ItalicFont     = *-Regular,
    ItalicFeatures = {FakeSlant = 0.2}
]

\setsansfont{NotoSerifSC}[
    Path        = \fontdir,
    Extension   = .ttf,
    UprightFont = *-Regular,
    BoldFont    = *-Bold
]
\setmonofont{NotoSerifSC}[
    Path        = \fontdir,
    Extension   = .ttf,
    UprightFont = *-Regular,
    BoldFont    = *-Bold
]

