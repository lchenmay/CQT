% sectsty 加载时会用 \CheckCommand 检查 \underbar/\underline，这两个命令通常已被其它包重定义，
% 产生无行号的 LaTeX Warning；silence 包拦截不到 @latex@warning@no@line，这里直接补丁屏蔽。
\makeatletter
\let\orig@latex@warning@no@line\@latex@warning@no@line
\def\@latex@warning@no@line#1{%
  \in@{\underbar}{#1}%
  \ifin@\else
    \in@{\underline}{#1}%
    \ifin@\else
      \orig@latex@warning@no@line{#1}%
    \fi
  \fi}
\makeatother
