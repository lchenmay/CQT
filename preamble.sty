\usepackage{listings}
\usepackage{xcolor}

% 定义颜色
\definecolor{codegreen}{rgb}{0,0.6,0}
\definecolor{codegray}{rgb}{0.5,0.5,0.5}
\definecolor{codepurple}{rgb}{0.58,0,0.82}
\definecolor{backcolour}{rgb}{0.95,0.95,0.92}

% 代码样式
\lstdefinestyle{mystyle}{
    backgroundcolor=\color{backcolour},
    commentstyle=\color{codegreen},
    keywordstyle=\color{magenta},
    numberstyle=\tiny\color{codegray},
    stringstyle=\color{codepurple},
    basicstyle=\ttfamily\footnotesize,
    breakatwhitespace=false,      % 允许在非空白字符处折行
    breaklines=true,              % 核心：必须开启自动折行
    captionpos=b,
    columns=flexible,             % 弹性列宽，防止代码符号被机械拉伸
    extendedchars=true,           % 允许代码中出现中文注释而不乱码
    keepspaces=true,              % 保持空格
    numbers=left,
    numbersep=5pt,
    showspaces=false,
    showstringspaces=false,
    showtabs=false,
    tabsize=2,
    frame=single,                 % 给代码块加个边框，强制约束其物理边界
    framerule=0.5pt,
    rulecolor=\color{gray!30}
}
\lstset{style=mystyle}

% 语言定义
\lstdefinelanguage{FSharp}{
    morekeywords={let,new,type,in,fun,match,with,rec,open,module,namespace,do,begin,end,then,else,if,struct,enum,delegate,class,interface,abstract,sealed,override,default,static,void,public,private,internal,const,mutable,inline,when,yield,return,forall},
    sensitive=true,
    morecomment=[l]{//},
    morecomment=[s]{(*}{*)},
    morestring=[b]",
}

\lstdefinelanguage{TypeScript}{
    morekeywords={const,let,var,function,return,export,import,from,as,type,interface,class,extends,implements,new,delete,this,super,console,require,module,typeof,instanceof,if,else,switch,case,default,for,while,do,break,continue,try,catch,finally,throw,async,await,Promise,string,number,boolean,void,never,any,unknown},
    sensitive=true,
    morecomment=[l]{//},
    morecomment=[s]{/*}{*/},
    morestring=[b]',
    morestring=[b]",
    morestring=[b]`,
}

\lstdefinelanguage{JSON}{
    morekeywords={true,false,null},
    sensitive=false,
    morestring=[b]",
    morestring=[d]'
}

% 自定义样式
